# WhatsApp number in wa.me format: country code + number, digits only (no + or spaces).
NEXT_PUBLIC_WHATSAPP_NUMBER=919495163651

# Optional: Google Search Console verification token (URL-prefix property, "HTML tag" method).
# Paste ONLY the content value from the meta tag Google shows you, e.g.
#   <meta name="google-site-verification" content="AbC123..."> -> AbC123...
# Leave blank if you verify by uploading Google's HTML file to /public instead.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
